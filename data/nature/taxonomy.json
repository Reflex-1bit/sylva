      "id": "process",
      "label": "Process",
      "question": "Can we make this the way nature makes things: at ambient temperature and pressure, in water, without toxic inputs?"
    },
    {
      "id": "materials",
      "label": "Materials",
      "question": "Can a bio-based, recycled or regenerative material replace this one?"
    },
    {
      "id": "energy",
      "label": "Energy",
