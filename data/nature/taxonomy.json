  "evidence_grades": [
    {
      "id": "strong",
      "rule": "At least 2 sources with a DOI or URL and at least 1 measured value."
    },
    {
      "id": "moderate",
      "rule": "At least 2 sources, or 1 source with a measured value."
    },
    {
      "id": "weak",
      "rule": "1 source and no measured value."
    },
    {
      "id": "contested",
      "rule": "Provenance is disputed or a popular-claim note is set. Takes precedence over all other grades."
    }
